; SpinLab XR native OpenXR edition. Godot 4.7.2.
config_version=5

[application]
config/name="SpinLab XR"
config/version="0.3.0"
config/icon="res://icon.svg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=1000
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=2
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.025,0.047,0.075,1)

[xr]
openxr/enabled=true
openxr/default_action_map="res://openxr_action_map.tres"
openxr/extensions/hand_tracking=false
shaders/enabled=true

[audio]
driver/enable_input=false

[debug]
gdscript/warnings/treat_warnings_as_errors=false
